# Exclude these from Docker build context

.git
.gitignore
.env
.env.*
*.md
!README.md

# Runtime data — not needed in image
data/
reports/
logs/
screenshots/
output/
*.log

# Python cache
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Dev tools
.vscode/
.idea/
.mypy_cache/
.pytest_cache/

# Large wordlists — mounted as volumes
wordlists/

# macOS
.DS_Store
